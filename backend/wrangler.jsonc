{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "kgdev-me-backend",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-04-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "build": {
    "command": "cargo install -q worker-build --version '=0.8.4' && worker-build --release"
  },
  "workers_dev": false,
  "route": {
    "pattern": "blog-api.kgdev.me",
    "custom_domain": true
  },
  "dev": {
    "port": 8000
  },
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VIEW_COUNTER",
        "class_name": "ViewCounter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ViewCounter"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "BlogPostQA"
      ]
    },
    {
      "tag": "v3",
      "deleted_classes": [
        "BlogPostQA"
      ]
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "CLOUDFLARE_SITEVERIFY_URL": "https://challenges.cloudflare.com/turnstile/v0/siteverify",
    "DESTINATION_EMAIL": "gray.kieran@protonmail.com",
    "ALLOWED_ORIGINS": "https://kgdev.me"
  },
  "secrets": {
    "required": [
      "CLOUDFLARE_TURNSTILE_SECRET_KEY",
      "CLOUDFLARE_EMAIL_API_TOKEN",
      "CLOUDFLARE_ACCOUNT_ID"
    ]
  },
  "env": {
    "dev": {
      "build": {
        "command": "cargo install -q worker-build --version '=0.8.4' && worker-build --release"
      },
      "vars": {
        "ENVIRONMENT": "dev",
        "CLOUDFLARE_SITEVERIFY_URL": "https://challenges.cloudflare.com/turnstile/v0/siteverify",
        "DESTINATION_EMAIL": "gray.kieran@protonmail.com",
        "ALLOWED_ORIGINS": ""
      },
      "secrets": {
        "required": [
          "CLOUDFLARE_TURNSTILE_SECRET_KEY",
          "CLOUDFLARE_EMAIL_API_TOKEN",
          "CLOUDFLARE_ACCOUNT_ID"
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "VIEW_COUNTER",
            "class_name": "ViewCounter"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "ViewCounter"
          ]
        },
        {
          "tag": "v2",
          "new_sqlite_classes": [
            "BlogPostQA"
          ]
        },
        {
          "tag": "v3",
          "deleted_classes": [
            "BlogPostQA"
          ]
        }
      ]
    }
  }
}
